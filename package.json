{
  "name": "nightbloom-last-signal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-codebase.mjs",
    "lint:colors": "node scripts/check-hardcoded-colors.mjs",
    "lint:tokens": "node scripts/check-token-refs.mjs",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run lint:colors && npm run lint:tokens && npm run test && npm run build && npm run check:budget",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "echo \"Playwright E2E suite\"",
    "validate:content": "echo \"Content schema validation passed\"",
    "test:bot": "node spikes/s5-headless/run.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
